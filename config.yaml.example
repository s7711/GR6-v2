# Shared runtime config for GR6-v2 — single source of truth for every
# service's systemd unit name, web UI host/port, and icon.
# See top-prd.md ("Shared configuration") and manager/manager-prd.md.
#
# Copy this file to config.yaml and fill in real values — config.yaml
# itself is gitignored since it holds this robot's real IP address.

xnav_ip: 192.168.0.0  # placeholder — set to the real xNAV650 IP

# Water butt funnel, relative to the aruco camera on the same rigid
# mount - in c (X forward out of the camera, Y right, Z down), not the
# raw camera frame. See waterbutt-prd.md's "QC marker" section.
waterbutt_funnel_offset_c: [0.0, 0.0, 0.0]  # placeholder — measure the real offset

services:
  manager:
    unit: robot-manager.service
    host: 0.0.0.0
    port: 8000
    web_ui: true

  hello:
    unit: robot-hello.service
    host: 0.0.0.0
    port: 8001
    web_ui: true

  oxts-nav:
    unit: robot-oxts-nav.service
    host: 0.0.0.0
    port: 8002
    web_ui: true
    protocol: ncom  # ncom or ucom - which decoder/port oxts-nav listens with. Read once at startup, restart the service to change - see ncom-to-ucom-mapping.md
    nav_update_hz: 2
    nav_feed_socket: /tmp/gr6-oxts-nav-feed.sock  # Unix domain socket — see "Nav data feed" in oxts-nav-prd.md
    nav_feed_hz: 20
    stale_after_s: 2.0  # blank nav/status/connection once nothing's been decoded for this long — see oxts-nav-prd.md's "Staleness"
    hpr_ib: [-90, 90, 0]  # IMU-to-body mounting (mobile.vat) — read by aruco too, for GAD lever-arm/alignment frames
    aruco_priority_timeout_s: 3.0  # "Aruco priority" mode falls back to GNSS if no marker's been seen for this long — see navigate-prd.md

  camera:
    unit: robot-camera.service
    host: 0.0.0.0
    port: 8003
    web_ui: true
    camera_fps: 5  # Resolution is fixed (1280x960), not configurable — see camera-prd.md
    camera_shm_name: gr6-camera-frame

  aruco:
    unit: robot-aruco.service
    host: 0.0.0.0
    port: 8004
    web_ui: true
    marker_map_file: aruco/data/marker-map.yaml
    max_detection_hz: 2   # cap on marker detection/GAD-send rate — see aruco-prd.md "Detection rate limit"
    camera_extrinsics:
      hpr_cb: [0, 0, 0]  # camera mount HPR relative to body; unmeasured/assumed — see aruco-prd.md bore-sight note
      d_xc_b: [0.0775, 0.002, -0.07]  # camera displacement in body frame, metres

  drive:
    unit: robot-drive.service
    host: 0.0.0.0
    port: 8005
    web_ui: true
    serial_port: /dev/ttyUSB0       # re-check once the Pico is fitted — likely /dev/ttyACM0 or similar
    baud: 115200
    counts_per_metre: 250            # from GR6-v1, needs re-measuring on this robot — the wheelspeed-GAD sender will depend on this being right
    wheel_base_m: 0.42               # distance between the two wheels' contact points, from GR6-v1 — lives here (not under navigate:) alongside counts_per_metre, the other physical-drivetrain constant; navigate reads it from here rather than keeping its own copy
    human_control_hold_ms: 500       # how long a manual jog command locks out automatic callers (navigate/jobs) — see drive-prd.md
    expected_firmware_version: "260720#1.GR6"
    drive_feed_socket: /tmp/gr6-drive-feed.sock  # Unix domain socket — see "Feed naming" in drive-prd.md
    drive_feed_hz: 20
    tuning: {}                        # optional, e.g. {Kp: [1.0, 1.0], Ki: [3.0, 3.0]} — pushed to the microcontroller each time drive starts

  navigate:
    unit: robot-navigate.service
    host: 0.0.0.0
    port: 8006
    web_ui: true
    paths_dir: navigate/data          # per-path YAML files — this robot's real-world data, not source (see .gitignore)
    control_hz: 10                    # how often navigate recomputes and sends a velocity command to drive/command/auto
    entry_max_distance_m: 1.0         # path-entry scan threshold — from GR6-v1, unchanged
    entry_max_heading_deg: 60         # path-entry scan threshold — raised from 45 (2026-08-11), see navigate-prd.md
    lookahead_distance_m: 0.4         # pure-pursuit lookahead distance — from GR6-v1, live-settable via a tuning page
    heading_gain: 0.8                 # pure-pursuit curvature gain (multiplies 2*sin(heading_error)/lookahead_distance_m, then forward speed — see geometry.py's turn_command) — field-tested 2026-07-23, tracks well
    cte_gain: 0.3                     # pure-pursuit cross-track-error gain, same rewrite/speed-scaling as heading_gain above — lowered from an untested 1.2 after a slow-decaying oscillation was seen live; the un-lookahead'd cte term has no phase lead, unlike the heading term, so it's the likely source of underdamping
    localisation_accuracy_limit_m: 1.0  # abort if oxts-nav's horizontal accuracy RMS exceeds this — per-segment via clearance_m for cross-track, but this one stays a single global constant, from GR6-v1
    max_heading_correction_deg: 70    # abort if heading error to the lookahead point exceeds this — from GR6-v1, unchanged
    navigate_feed_socket: /tmp/gr6-navigate-feed.sock  # Unix domain socket — see navigate-prd.md
    navigate_feed_hz: 10               # matches control_hz — see navigate-prd.md's "Config additions"
    log_retention_days: 2              # per-run debug logs (navigate/data/logs/) — same convention/value as jobs and missions
    stall_check_window_s: 5.0          # "hasn't moved" watchdog (added 2026-08-18) — checked every window, not continuously, see stall.py
    stall_min_distance_m: 0.10         # path-following: abort if less than this is covered in stall_check_window_s
    turn_stall_min_deg: 5.0            # turning in place: same idea, measuring heading change instead of distance
    turn_gain: 1.0                     # proportional heading control for turn-in-place — rad/s of turn rate per rad of heading error
    turn_max_rate_rad_s: 0.5           # cap on commanded turn rate (~29deg/s) — untested live yet, start slow
    turn_max_mps: 0.15                 # cap on either wheel's speed while turning in place
    turn_tolerance_deg: 10.0           # default heading tolerance for a turn_to_heading job step that doesn't specify its own

  network:
    unit: robot-network.service
    host: 0.0.0.0
    port: 8007
    web_ui: true

  wheelspeed:
    unit: robot-wheelspeed.service
    host: 0.0.0.0
    port: 8008
    web_ui: true
    gad_type: GadVelocity            # or GadSpeed — see wheelspeed-prd.md
    left_wheel:
      lever_arm_i: [0.0, 0.0, 0.0]  # IMU -> left wheel, IMU frame, metres — unmeasured placeholder, MEASURE AND SET
      scale: 1.0                     # fudge factor on top of drive's own m/s velocity; normally 1.0
    right_wheel:
      lever_arm_i: [0.0, 0.0, 0.0]  # IMU -> right wheel, IMU frame, metres — unmeasured placeholder, MEASURE AND SET
      scale: 1.0                     # fudge factor on top of drive's own m/s velocity; normally 1.0

  waterbutt:
    unit: robot-waterbutt.service
    host: 0.0.0.0
    port: 8009
    web_ui: true
    hostname: waterbutt.local  # mDNS name the ESP8266 valve controller advertises — see waterbutt/waterbutt-prd.md
    qc_marker_file: waterbutt/data/qc-marker.yaml  # the single saved "ideal position" marker record — see waterbutt-prd.md's QC marker section
    qc_default_threshold_m: 0.08  # used whenever /go's own caller doesn't pick a tolerance (e.g. jobs' `fill` step) — see waterbutt-prd.md's "QC gating on fill"
    log_retention_days: 2  # QC reading logs (waterbutt/data/logs/) — same convention/value as navigate/jobs/missions
    qc_log_rotate_s: 3600  # rotate to a fresh QC log file this often while the service keeps running — see app.py's _start_new_qc_log

  jobs:
    unit: robot-jobs.service
    host: 0.0.0.0
    port: 8010
    web_ui: true
    jobs_dir: jobs/data
    job_status_hz: 2
    log_retention_days: 2

  missions:
    unit: robot-missions.service
    host: 0.0.0.0
    port: 8011
    web_ui: true
    missions_dir: missions/data
    mission_status_hz: 2
    log_retention_days: 2

  map-manager:
    unit: robot-map-manager.service
    host: 0.0.0.0
    port: 8012
    web_ui: true
    map_dir: map-manager/data          # persisted grid.json — this robot's real garden data, not source (see .gitignore)
    control_hz: 5                       # how often the tick loop reads the nav/drive feeds and updates the grid
    save_interval_s: 30                 # autosave the grid to disk if anything changed since the last save
    cell_size_m: 0.10
    max_range_m: 1.2                    # ultrasonics aren't trusted beyond this — see map-manager-prd.md
    beam_half_angle_deg: 7.5            # half of the ultrasonics' ~15 degree cone
    forget_after_days: 30               # a cell with no fresh hit/miss in this long reads back as "unknown" — see grid.py's cell_value
    min_observations: 2                 # a cell needs at least this many hit+miss readings before it's trusted at all
    accuracy_h_max_m: 0.03              # only update the grid while oxts-nav's horizontal accuracy is at least this good
    accuracy_v_max_m: 0.05              # same, vertical
    map_origin_lat: 0.0                 # placeholder — SET to the waterbutt QC marker's own surveyed lat (aruco marker id 12, aruco/data/marker-map.yaml) — fixed reference point the whole persistent grid is built relative to (see map-manager-prd.md "Reference frame"). Real value deliberately not committed here - it's this robot's real-world location (see config.yaml, gitignored)
    map_origin_lon: 0.0                 # see map_origin_lat
    # One entry per ultrasonic sensor (5 on this robot), body frame (x
    # forward, y right, z down, metres, from the nav system's own
    # reference point) same lever-arm convention as wheelspeed's
    # lever_arm_i/aruco's d_xc_b/waterbutt's funnel offset. `tag` matches
    # drive's own ultrasonic_<tag>_mm feed field (0-indexed - see
    # drive/firmware's ultrasonicPins array) and drive/templates/pages/
    # ultrasonics.html's own position/facing diagram, which is where
    # heading_deg below comes from - x/y/z are placeholders — MEASURE AND SET.
    sensors:
      - {tag: 0, x: 0.0, y: 0.0, z: 0.0, heading_deg: 0.0}    # front-right, facing forward
      - {tag: 1, x: 0.0, y: 0.0, z: 0.0, heading_deg: 90.0}   # back-right, facing right
      - {tag: 2, x: 0.0, y: 0.0, z: 0.0, heading_deg: 180.0}  # back-centre, facing backward
      - {tag: 3, x: 0.0, y: 0.0, z: 0.0, heading_deg: 270.0}  # back-left, facing left
      - {tag: 4, x: 0.0, y: 0.0, z: 0.0, heading_deg: 0.0}    # front-left, facing forward
