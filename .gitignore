__pycache__/
*.pyc
venv/

# Real config holds this robot's actual IP addresses — see config.yaml.example
config.yaml

# Runtime-generated, device-specific — not source
manager/config-backup/
oxts-nav/xnav-config/
*.log

# Camera calibration — device/lens-specific, see camera/camera-prd.md
shared/camera-cal.yaml
camera/data/

# Surveyed marker positions — this robot's real-world data, see aruco-prd.md
aruco/data/

# Recorded paths — this robot's real-world data, see navigate-prd.md
navigate/data/

# Saved jobs + run logs — this robot's real-world data, see jobs-prd.md
jobs/data/

# Saved missions + run logs — this robot's real-world data, see missions-prd.md
missions/data/

# Saved QC marker record — this robot's real-world calibration, see
# waterbutt-prd.md's QC marker section
waterbutt/data/

# Per-interface recovery choices — this robot's own runtime state, see
# network/network-prd.md
network/recovery.json

# Persisted occupancy grid — this robot's real garden data, see
# map-manager-prd.md
map-manager/data/

# Compiled firmware artifacts — a build output, not source; the .ino is
# the source of truth, see drive-prd.md
drive/firmware/*.hex

# Claude Code's own local tooling state, not project source
.claude/
